@@ -558,0 +562,25 @@ func buildAttempts(parsed ParsedFile, originalFilename, mediaRoot string) []sear
+func searchMediaType(parsed ParsedFile, filename string) MediaType {
+	if parsed.MediaType == MediaTypeMovie && isCyrillicSeries(filename) {
+		return MediaTypeTV
+	}
+	return parsed.MediaType
+}
+
+var yoToYe = strings.NewReplacer("ё", "е", "Ё", "Е")
+
+func yoSearchAttempts(parsed ParsedFile, filename string) []searchAttempt {
+	if !strings.ContainsAny(parsed.CleanTitle, "ёЁ") ||
+		resolveHomoglyphs(ParseFilename(filename).CleanTitle) != parsed.CleanTitle {
+		return nil
+	}
+	query := yoToYe.Replace(parsed.CleanTitle)
+	mediaType := searchMediaType(parsed, filename)
+	if parsed.Year > 0 {
+		return []searchAttempt{
+			{query, parsed.Year, parsed.Year, mediaType, "ё→е+рік"},
+			{query, 0, parsed.Year, mediaType, "ё→е без року"},
+		}
+	}
+	return []searchAttempt{{query, 0, 0, mediaType, "ё→е без року"}}
+}
