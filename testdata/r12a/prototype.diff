+func (c *Client) searchAttempts(ctx context.Context, parsed ParsedFile, originalFilename string, attempts []searchAttempt) (*MovieInfo, error) {
@@ -507 +511 @@ func buildAttempts(parsed ParsedFile, originalFilename, mediaRoot string) []sear
